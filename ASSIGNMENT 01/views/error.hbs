<section class="error-section" style="padding: 100px 0; text-align: center;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="error-content">
                    <h1 style="font-size: 4rem; color: #6366f1; margin-bottom: 1rem;">Oops!</h1>
                    <h2 style="margin-bottom: 2rem;">{{title}}</h2>
                    <p class="lead" style="font-size: 1.2rem; margin-bottom: 2rem;">{{message}}</p>
                    <a href="/" class="btn btn-primary btn-lg">
                        <i class="fas fa-home me-2"></i>Back to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>